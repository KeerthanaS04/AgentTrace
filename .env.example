# Copy to .env and fill in. Never commit .env.

# --- Model providers ---
# Meta Model API (Muse Spark, Muse Wonder)
MODEL_API_KEY=
# NVIDIA NIM hosted endpoints
NVIDIA_API_KEY=
# OpenRouter (open-source judges / agents), optional
OPENROUTER_API_KEY=
# Local vLLM or other OpenAI-compatible server, optional
LOCAL_OPENAI_BASE_URL=http://localhost:8000/v1
LOCAL_OPENAI_API_KEY=local

# --- Budget guard (USD) ---
MAX_USD_PER_RUN=1.00
MAX_USD_TOTAL=140.00
WARN_USD_TOTAL=100.00

# --- Storage ---
AGENTTRACE_DB_URL=sqlite:///agenttrace.db
AGENTTRACE_CACHE_DIR=.cache
